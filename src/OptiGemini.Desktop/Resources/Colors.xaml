<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Primary Colors (Blue) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1E88E5"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1565C0"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#64B5F6"/>
    
    <!-- Success/Running State -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="SuccessDarkBrush" Color="#388E3C"/>
    
    <!-- Warning/Paused State -->
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9800"/>
    <SolidColorBrush x:Key="WarningDarkBrush" Color="#F57C00"/>
    
    <!-- Error/Stopped State -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#F44336"/>
    <SolidColorBrush x:Key="ErrorDarkBrush" Color="#D32F2F"/>
    
    <!-- Neutral Colors -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
    
    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#757575"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#BDBDBD"/>
    
</ResourceDictionary>
